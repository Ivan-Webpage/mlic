{
  "name": "mlic",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run generate-sitemap && ng build && node scripts/copy-404.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run mlic:serve-ssr",
    "serve:ssr": "node dist/mlic/server/main.js",
    "build:ssr": "npm run generate-sitemap && ng build && ng run mlic:server",
    "prerender": "ng run mlic:prerender",
    "deploy": "node scripts/deploy.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.28",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.28",
    "@angular/compiler": "^20.3.28",
    "@angular/core": "^20.3.28",
    "@angular/forms": "^20.3.28",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.28",
    "@angular/platform-browser-dynamic": "^20.3.28",
    "@angular/platform-server": "^20.3.28",
    "@angular/router": "^20.3.28",
    "@angular/ssr": "^20.3.34",
    "@fortawesome/angular-fontawesome": "^2.0.0",
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.0",
    "@ng-web-apis/common": "^4.14.1",
    "@popperjs/core": "^2.11.8",
    "express": "^4.15.2",
    "marked": "^16.4.2",
    "mdb-angular-ui-kit": "^4.1.0",
    "ngx-markdown": "^20.1.0",
    "ngx-masonry": "^14.0.1",
    "ngx-scrolltop": "^20.2.0",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.34",
    "@angular/cli": "~20.3.34",
    "@angular/compiler-cli": "^20.3.28",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^20.19.43",
    "browser-sync": "^3.0.0",
    "gh-pages": "^6.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.9.3"
  }
}